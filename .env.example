# VoxChain root environment (read automatically by `docker compose`).
# Copy to `.env` and adjust. Never commit `.env`.
#
# Everything below is PUBLIC: NEXT_PUBLIC_* values are embedded in browser JavaScript.
# NEVER put private keys, mnemonics or API secrets in this file.
# (Deployer keys for an optional public testnet go in Hardhat's encrypted keystore:
#  `npx hardhat keystore set SEPOLIA_PRIVATE_KEY`, run from contracts/.)

# Hardhat local chain ID.
NEXT_PUBLIC_CHAIN_ID=31337

# RPC URL as seen by the BROWSER (MetaMask runs on Windows, not in Docker),
# so this stays 127.0.0.1 even when the frontend itself runs in a container.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Filled in after deploying Voting.sol (Phase 2).
NEXT_PUBLIC_CONTRACT_ADDRESS=
